{
  "name": "tw-stock-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:upload": "opennextjs-cloudflare upload",
    "cf:types": "wrangler types --env-interface CloudflareEnv --include-runtime false",
    "verify:cloudflare": "node scripts/verify-cloudflare-release.mjs",
    "start": "next start",
    "test": "node --test --experimental-transform-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON tests/*.test.mjs",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.49.0",
    "lightweight-charts": "^5.2.0",
    "next": "~15.5.27",
    "node-cron": "^4.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "swr": "^2.3.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "wrangler": "^4.123.0"
  },
  "overrides": {
    "next": {
      "postcss": "$postcss"
    },
    "sharp": "^0.35.5",
    "postcss-selector-parser": "7.1.6"
  }
}
