# Supabase（後端專用，service key 切勿外洩到前端）
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Tavily（Phase 4 消息面才需要）
TAVILY_API_KEY=
TAVILY_MONTHLY_CREDIT_CAP=800

# FinMind（本機放 .env.local；Worker runtime 放 Cloudflare Worker Secret）
FINMIND_TOKEN=

# 單一密碼保護（部署到公開 URL 前務必設定；本機開發可留空）
APP_ACCESS_PASSWORD=

# 詳細健康檢查 token（用於 /api/health?detail=1 的 Bearer token；正式 Worker 必須設定）
HEALTH_DETAIL_TOKEN=

# 網站基礎網址（用於提醒連結；本機可設 http://localhost:3000）
APP_BASE_URL=
